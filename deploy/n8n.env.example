############
# n8n-CloudWEB — env for docker-compose
# Deploy via Portainer stack: n8n-cloudweb
# Copy this file and rename to n8n.env, fill in your values
############

# ─── Domain / URL ────────────────────────────────────────────
N8N_HOST=n8n.cloudweb.name
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_PUBLIC_URL=https://n8n.cloudweb.name
N8N_EDITOR_BASE_URL=https://n8n.cloudweb.name
N8N_WEBHOOK_EXTERNAL_PORT=443
WEBHOOK_URL=https://n8n.cloudweb.name

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Local: connects to supabase-db directly (same Docker host)
# Schema: n8n (created automatically on first run)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=supabase-db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=CHANGE_ME
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=false
#
# Remote / cross-host: use pooler (supavisor) — tenant=cloudweb-sb, transaction port 6543
# Uncomment DATABASE_URL and comment out the DB_POSTGRESDB_* block above.
# Pooler uses sslmode=require
# DB_TYPE=postgresdb
# DATABASE_URL=postgres://postgres.cloudweb-sb:${DB_POSTGRESDB_PASSWORD}@supabase-pooler:6543/postgres?schema=n8n&sslmode=require

# ─── Timezone ────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# ─── Security ────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SECURE_COOKIE=true

# ─── Proxy (behind Cloudflare Tunnel) ────────────────────────
N8N_PROXY_HOPS=1
N8N_METRICS_TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# ─── Executions ──────────────────────────────────────────────
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_PROCESS=main
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_METRICS=true

# ─── Storage ─────────────────────────────────────────────────
N8N_DEFAULT_BINARY_DATA_MODE=database

# ─── Email (SMTP) ────────────────────────────────────────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.yandex.ru
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_USER=CHANGE_ME
N8N_SMTP_PASS=CHANGE_ME
N8N_SMTP_SENDER=CHANGE_ME
N8N_SMTP_SENDER_NAME=CloudWEB Notification Bot

# ─── Advanced ────────────────────────────────────────────────
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# ─── SSO ─────────────────────────────────────────────────────
N8N_SSO_REDIRECT_LOGIN_TO_SSO=false

# ─── Resources ──────────────────────────────────────────────
N8N_MEM_LIMIT=2g
N8N_CPUS=2
