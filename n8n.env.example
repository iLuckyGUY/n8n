############
# n8n-CloudWEB — env for docker-compose
# Deploy via Portainer stack: n8n-cloudweb
# Copy this file and rename to n8n.env, then replace every CHANGE_ME.
# Never commit the filled-in n8n.env — only this .example file is allowed.
############

# ─── Domain / URL ────────────────────────────────────────────
N8N_HOST=n8n.cloudweb.name
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_PUBLIC_URL=https://n8n.cloudweb.name
N8N_EDITOR_BASE_URL=https://n8n.cloudweb.name
N8N_WEBHOOK_EXTERNAL_PORT=443
# Successor to the deprecated WEBHOOK_URL; sets the base URL for both test
# and production webhooks (WEBHOOK_URL only covered production ones).
N8N_WEBHOOK_URL=https://n8n.cloudweb.name

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Local: connects to supabase-db directly (same Docker host)
# Schema: n8n (created automatically on first run)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=supabase-db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=CHANGE_ME
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=false
#
# Remote / cross-host: use pooler (supavisor) — tenant=cloudweb-sb, transaction port 6543
# Uncomment DATABASE_URL and comment out the DB_POSTGRESDB_* block above.
# Pooler uses sslmode=require
# DB_TYPE=postgresdb
# DATABASE_URL=postgres://postgres.cloudweb-sb:${DB_POSTGRESDB_PASSWORD}@supabase-pooler:6543/postgres?schema=n8n&sslmode=require

# ─── Timezone ────────────────────────────────────────────────
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# ─── Security ────────────────────────────────────────────────
# Must match the encryptionKey in the n8n_data volume, else stored
# credentials cannot be decrypted and n8n refuses to start.
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_SECURE_COOKIE=true
# Allowlist of origins allowed to post messages to the editor (2.34+)
N8N_POSTMESSAGE_ALLOWED_ORIGINS=https://n8n.cloudweb.name

# ─── Proxy (behind Cloudflare Tunnel) ────────────────────────
N8N_PROXY_HOPS=1
N8N_METRICS_TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# ─── Executions ──────────────────────────────────────────────
EXECUTIONS_MODE=regular
EXECUTIONS_DATA_PROCESS=main
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_METRICS=true
# Offload large webhook responses to storage in scaling mode (2.34+)
N8N_WEBHOOK_RESPONSE_RELAY_OFFLOAD_ENABLED=false
# Pinned to the current default; n8n v3 reduces it to 60 seconds.
N8N_RUNNERS_TASK_TIMEOUT=300

# ─── Storage ─────────────────────────────────────────────────
N8N_DEFAULT_BINARY_DATA_MODE=database

# ─── Email (SMTP) ────────────────────────────────────────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.yandex.ru
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_USER=CHANGE_ME
N8N_SMTP_PASS=CHANGE_ME
N8N_SMTP_SENDER=CHANGE_ME
N8N_SMTP_SENDER_NAME=CloudWEB Notification Bot

# ─── Advanced ────────────────────────────────────────────────
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
# Agent evals timeout (2.34+)
N8N_AGENT_EVALS_RUN_TIMEOUT_MINUTES=60
# The three below are pinned to their current defaults, which n8n v3 changes:
# unverified packages -> false, decompressed size -> 256 MiB, zip entries -> 1000.
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# ─── SSO ─────────────────────────────────────────────────────
N8N_SSO_REDIRECT_LOGIN_TO_SSO=false
# OIDC (2.34+)
N8N_SSO_OIDC_ADDITIONAL_SCOPES=
N8N_SSO_OIDC_RP_INITIATED_LOGOUT_ENABLED=false

# ─── Resources ──────────────────────────────────────────────
N8N_MEM_LIMIT=2g
N8N_CPUS=2
